# Copy this to .env.local for local (non-Docker) development. All of these
# have sane defaults in app/config.py -- only set what you need to override.
DATABASE_PATH=./data/app.db
DOWNLOAD_DIR=./data/downloads
LOG_PATH=./data/app.log
POLL_INTERVAL_SECONDS=900
MAX_CONCURRENT_DOWNLOADS=1
SOURCE_BASE_URL=https://tiz-cycling.tv
